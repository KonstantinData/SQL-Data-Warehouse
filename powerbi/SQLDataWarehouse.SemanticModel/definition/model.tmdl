model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode"]

annotation PBI_QueryOrder = ["Customers","Products","Sales","Inventory Snapshots","Inventory Locations","Data Quality Checks","Refresh Metadata","SqlServerName","SqlDatabaseName","EnvironmentName","CommandTimeoutMinutes"]

ref table Customers
ref table Products
ref table Sales
ref table 'Inventory Snapshots'
ref table 'Inventory Locations'
ref table Date
ref table 'Data Quality Checks'
ref table 'Refresh Metadata'
ref table 'Security User Country'
ref table _Measures

ref role CountrySalesViewer
