table 'Data Quality Checks'
	lineageTag: 6b59bd3c-34c9-47c0-873c-8436ccf5d535

	column CheckKey
		dataType: string
		isKey
		sourceColumn: [CheckKey]
		summarizeBy: none

	column CheckName
		dataType: string
		sourceColumn: [CheckName]
		summarizeBy: none

	column Severity
		dataType: string
		sourceColumn: Severity
		summarizeBy: none

	column Layer
		dataType: string
		sourceColumn: Layer
		summarizeBy: none

	column Scope
		dataType: string
		sourceColumn: Scope
		summarizeBy: none

	column Status
		dataType: string
		sourceColumn: Status
		summarizeBy: none

	column FailedRows
		dataType: int64
		sourceColumn: FailedRows
		summarizeBy: sum

	column EvaluatedRows
		dataType: int64
		sourceColumn: EvaluatedRows
		summarizeBy: sum

	column PassRate
		dataType: double
		formatString: 0.0%
		sourceColumn: PassRate
		summarizeBy: average

	column IsEvaluated
		dataType: boolean
		sourceColumn: IsEvaluated
		summarizeBy: none

	column LastEvaluatedAtUtc
		dataType: dateTime
		formatString: yyyy-mm-dd hh:mm:ss
		sourceColumn: LastEvaluatedAtUtc
		summarizeBy: none

	partition 'Data Quality Checks' = m
		mode: import
		source =
			let
				Source = Sql.Database(SqlServerName, SqlDatabaseName, [CommandTimeout = #duration(0, 0, CommandTimeoutMinutes, 0)]),
				Query = "WITH checks AS (SELECT 'invalid_order_date' CheckKey, 'Invalid or blank order date' CheckName, 'Gold' Layer, 'Dataset' Scope, 'Error' Severity, SUM(CASE WHEN order_date_key = 0 THEN 1 ELSE 0 END) FailedRows, COUNT_BIG(*) EvaluatedRows FROM gold.fact_sales UNION ALL SELECT 'sales_equation_mismatch', 'Sales amount differs from quantity times price', 'Gold', 'Dataset', 'Warning', SUM(CASE WHEN sales_amount <> quantity * price OR sales_amount IS NULL OR quantity IS NULL OR price IS NULL THEN 1 ELSE 0 END), COUNT_BIG(*) FROM gold.fact_sales UNION ALL SELECT 'missing_customer_country', 'Customer country is missing or not normalized', 'Gold', 'Dataset', 'Warning', SUM(CASE WHEN country IS NULL OR country = 'Unknown' THEN 1 ELSE 0 END), COUNT_BIG(*) FROM gold.dim_customers UNION ALL SELECT 'future_customer_record', 'Customer creation date flagged as future', 'Gold', 'Dataset', 'Error', SUM(CONVERT(int, customer_is_future)), COUNT_BIG(*) FROM gold.dim_customers UNION ALL SELECT 'nonpositive_product_cost', 'Current product cost is nonpositive', 'Gold', 'Dataset', 'Warning', SUM(CASE WHEN product_cost IS NULL OR product_cost <= 0 THEN 1 ELSE 0 END), COUNT_BIG(*) FROM gold.dim_products WHERE is_current = 1 UNION ALL SELECT 'sales_line_baseline_variance', 'Synthetic sales line count differs from checked baseline', 'Gold', 'Fixture', 'Error', ABS(COUNT_BIG(*) - 60379), COUNT_BIG(*) FROM gold.fact_sales UNION ALL SELECT 'product_key_uniqueness', 'Current product business key is not unique', 'Gold', 'Dataset', 'Error', COUNT_BIG(*) - COUNT_BIG(DISTINCT product_number), COUNT_BIG(*) FROM gold.dim_products WHERE is_current = 1 UNION ALL SELECT 'gold_source_orphan_coverage', 'Gold Unknown-member coverage', 'Gold', 'Dataset', 'Error', SUM(CASE WHEN customer_key = 0 OR product_key = 0 THEN 1 ELSE 0 END), COUNT_BIG(*) FROM gold.fact_sales) SELECT CheckKey, CheckName, Layer, Scope, Severity, CASE WHEN EvaluatedRows IS NULL OR EvaluatedRows = 0 THEN 'Not run' WHEN FailedRows > 0 THEN 'Failed' ELSE 'Passed' END Status, FailedRows, EvaluatedRows, CASE WHEN EvaluatedRows IS NULL OR EvaluatedRows = 0 THEN NULL WHEN FailedRows > 0 THEN CONVERT(float, 0) ELSE CONVERT(float, 1) END PassRate, CONVERT(bit, CASE WHEN EvaluatedRows IS NULL OR EvaluatedRows = 0 THEN 0 ELSE 1 END) IsEvaluated, SYSUTCDATETIME() LastEvaluatedAtUtc FROM checks",
				Result = Value.NativeQuery(Source, Query, null, [EnableFolding = true])
			in
				Result
