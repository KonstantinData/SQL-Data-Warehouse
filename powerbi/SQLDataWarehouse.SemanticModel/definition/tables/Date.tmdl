table Date
	dataCategory: Time
	lineageTag: ecfc86c8-077c-4a3e-a63f-df23445d4e31

	column Date
		dataType: dateTime
		isKey
		formatString: yyyy-mm-dd
		sourceColumn: [Date]
		summarizeBy: none

	column Year = YEAR('Date'[Date])
		dataType: int64
		formatString: 0
		summarizeBy: none

	column Month = FORMAT('Date'[Date], "MMM")
		dataType: string
		sortByColumn: 'Month Number'
		summarizeBy: none

	column 'Month Number' = MONTH('Date'[Date])
		dataType: int64
		isHidden
		summarizeBy: none

	column 'Month Start' = DATE(YEAR('Date'[Date]), MONTH('Date'[Date]), 1)
		dataType: dateTime
		formatString: yyyy-MM
		summarizeBy: none

	partition Date = calculated
		mode: import
		source = CALENDAR(DATE(2010, 1, 1), DATE(2035, 12, 31))
