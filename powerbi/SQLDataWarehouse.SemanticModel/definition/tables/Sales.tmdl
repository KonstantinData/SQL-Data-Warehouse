		annotation SummarizationSetBy = Automatic

	partition Sales = m
		mode: import
		source =
				let
					Source = Sql.Database(SqlServerName, SqlDatabaseName, [CommandTimeout = #duration(0, 0, CommandTimeoutMinutes, 0)]),
					Query = "SELECT f.order_number, f.product_key, f.product_number, c.customer_id, f.order_date, f.ship_date, f.due_date, CONVERT(decimal(19,4), f.sales_amount) AS sales_amount, f.quantity, CONVERT(decimal(19,4), f.price) AS price FROM gold.fact_sales f INNER JOIN gold.dim_customers c ON c.customer_key = f.customer_key",
					Result = Value.NativeQuery(Source, Query, null, [EnableFolding = true])
				in
					Result
